{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/", "destination": "/case", "permanent": false }
  ],
  "rewrites": [
    { "source": "/case/api/:path*", "destination": "/api/:path*" },
    { "source": "/case/:path*", "destination": "/case/index.html" }
  ]
}
